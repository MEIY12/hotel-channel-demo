# Contentful Configuration
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# Your Contentful Space ID (found in Settings > General Settings)
NEXT_PUBLIC_CONTENTFUL_SPACE_ID=your_space_id_here

# Content Delivery API Access Token (Settings > API Keys)
NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=your_delivery_token_here

# Content Preview API Access Token (Settings > API Keys)
NEXT_PUBLIC_CONTENTFUL_PREVIEW_TOKEN=your_preview_token_here

# Environment (usually 'master')
NEXT_PUBLIC_CONTENTFUL_ENVIRONMENT=master

# Set to 'true' to enable preview mode
NEXT_PUBLIC_CONTENTFUL_PREVIEW=false
