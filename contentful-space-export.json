      "fields": {
        "propertyName": {
          "en-US": "The Avalon Denver"
        },
        "heroHeadline": {
          "en-US": "Where Rocky Mountain elevation meets elevated hospitality"
        },
        "location": {
          "en-US": "Downtown Denver, walking distance to Union Station"
        },
        "roomType": {
          "en-US": "Skyline Suite"
        },
        "roomDescription": {
          "en-US": "Floor-to-ceiling windows frame panoramic views of the Front Range. This 450-square-foot retreat features a king bed, spa-inspired bathroom, and workspace designed for the modern traveler. Thoughtfully curated details include locally sourced bath amenities, premium linens, and a Bluetooth sound system for your favorite playlists."
        },
        "neighborhoodVibe": {
          "en-US": "In the heart of LoDo, you're steps from craft breweries, the Denver Performing Arts Complex, and Coors Field. The 16th Street Mall's free shuttle connects you to the entire downtown corridor, while Union Station's restaurants and bars create an energetic dining scene just outside your door."
        },
        "signatureExperience": {
          "en-US": "Start your day with our complimentary coffee service featuring beans from local roasters, then explore Denver's 300 days of sunshine. Our concierge team curates personalized itineraries featuring hidden gems from Red Rocks to Rocky Mountain National Park."
        },
        "keyAmenities": {
          "en-US": [
            "Rooftop bar with mountain views",
            "Complimentary bike rentals",
            "High-speed WiFi throughout",
            "24-Hour Fitness Center"
          ]
        },
